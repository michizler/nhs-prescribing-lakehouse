{
  "name": "epd-theme",
  "dataColors": [
    "#005EB8",
    "#ED8B00",
    "#00A499",
    "#AE2573",
    "#41B6E6"
  ],
  "foreground": "#231F20",
  "background": "#FFFFFF",
  "tableAccent": "#005EB8",
  "good": "#009639",
  "neutral": "#FFB81C",
  "bad": "#DA291C",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#E8EDEE"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      },
      "valueAxis": [
        {
          "gridlineColor": {
            "solid": {
              "color": "#E8EDEE"
            }
          },
          "gridlineStyle": "solid",
          "labelColor": {
            "solid": {
              "color": "#425563"
            }
          }
        }
      ],
      "categoryAxis": [
        {
          "labelColor": {
            "solid": {
              "color": "#425563"
            }
          },
          "gridlineShow": false
        }
      ]
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ]
      }
    }
  }
}